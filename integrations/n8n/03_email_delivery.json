    },
    {
      "parameters": {
        "jsCode": "if(!$json.id)throw new Error('Gmail returned no message ID. Inspect Sent mail before retrying.');return [{json:{ok:true,provider_id:$json.id}}];"
      },
      "id": "79bb7b2f-b3dd-5284-9ed9-eac3167de0f5",
