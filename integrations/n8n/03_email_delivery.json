    },
    {
      "parameters": {
        "jsCode": "if(!$json.ok)throw new Error($json.error||'Solar API failed');\nreturn [{json:$json.result||{ok:true}}];"
      },
      "id": "414c3c8e-4d58-5e81-b153-4a8aaf1a8d5f",
