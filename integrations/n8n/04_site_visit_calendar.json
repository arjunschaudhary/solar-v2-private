        "jsonBody": "={{ ({token:$('Connection settings').first().json.api_token,type:\"finish_delivery\",request_id:'n8n:'+$execution.id+':finish_delivery'+':'+$itemIndex,payload:({...$json,delivery_id:$('Delivery ready').first().json.task.delivery_id,claim_token:$('Delivery ready').first().json.task.claim_token}),actor:'n8n'}) }}",
        "options": {
