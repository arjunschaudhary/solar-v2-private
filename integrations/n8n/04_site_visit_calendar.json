{
  "name": "Solar V2 · 04 · Site visit calendar",
  "nodes": [
    {
      "parameters": {
        "content": "## 04 · Site visit calendar\nClaims one calendar task per run. Uses stable event IDs for create/update/cancel. TEST requires a separate calendar. No attendees are invited automatically. Select the same Calendar credential in all four Calendar HTTP nodes.\n\nImport inactive. Set Connection settings, then select your Google credentials. V2_Config starts TEST / automation No. Read CONNECTING.md before testing.",
        "height": 260,
        "width": 620
      },
      "id": "b92d9ac3-7b09-5631-a74b-9575d1070c09",
      "name": "Read first",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -350
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "id": "2495a65b-a1a6-5068-b02d-32f93eb9b170",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "1c8efc6d-9775-5860-af83-c48952dfe448",
      "name": "Run once",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        170
      ]
    },
    {
      "parameters": {
        "jsCode": "// Configure these two values after deploying the Apps Script bridge.\n// Keep configured exports private: this field contains an integration secret.\nconst api_url = 'https://script.google.com/macros/s/REPLACE_DEPLOYMENT_ID/exec';\nconst api_token = 'REPLACE_WITH_SCRIPT_PROPERTY_TOKEN';\nconst use_ai = false; // Deliberately off. No AI credential needed for rules.\nreturn $input.all().map((item,index)=>({json:{...item.json,api_url,api_token,use_ai},pairedItem:{item:index}}));"
      },
      "id": "9986b0ee-3125-52a6-9834-e646f12e7472",
      "name": "Connection settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Connection settings').first().json.api_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({token:$('Connection settings').first().json.api_token,type:\"claim_delivery\",request_id:'n8n:'+$execution.id+':claim_delivery'+':'+$itemIndex,payload:{\"kind\": \"calendar\"},actor:'n8n'}) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "97f18281-cf21-5be5-9539-b4df79abe331",
      "name": "Claim delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "if(!$json.ok)throw new Error($json.error||'Solar API failed');\nif(!$json.result?.task)return [];\nreturn [{json:{task:$json.result.task}}];"
      },
      "id": "84c9bcba-1336-5102-82e8-3c6c5ca34da5",
      "name": "Claim available",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Connection settings').first().json.api_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({token:$('Connection settings').first().json.api_token,type:\"begin_delivery\",request_id:'n8n:'+$execution.id+':begin_delivery'+':'+$itemIndex,payload:({delivery_id:$json.task.delivery_id,claim_token:$json.task.claim_token}),actor:'n8n'}) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "4fa80fef-e6d6-589f-9067-d4f73a3c1bc9",
      "name": "Begin delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "if(!$json.ok)throw new Error($json.error||'Solar API failed');\nif(!$json.result?.task)return [];\nreturn [{json:{task:$json.result.task}}];"
      },
      "id": "ae00a3fb-2215-5c3c-8106-be67a89fc177",
      "name": "Delivery ready",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const t=$json.task,v=t.payload.visit;const event_id='solar'+v.site_visit_id.replace(/[^a-f0-9]/gi,'').toLowerCase();const collection='https://www.googleapis.com/calendar/v3/calendars/'+encodeURIComponent(t.payload.calendar_id)+'/events';return [{json:{event_id,collection,url:collection+'/'+event_id,operation:t.payload.operation,body:{id:event_id,summary:(t.send_mode==='LIVE'?'':'[TEST] ')+'Solar site visit · '+v.client_name,description:'Engineer: '+v.assigned_engineer+'\\nDocuments: '+(v.required_documents||'')+'\\n'+(v.visit_notes||''),start:{dateTime:v.starts_at,timeZone:'Asia/Kolkata'},end:{dateTime:v.ends_at,timeZone:'Asia/Kolkata'}}}}];"
      },
      "id": "33b405a9-bbb6-5a83-8692-3ab1bbf0d35b",
      "name": "Calendar request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "8e6705a2-0259-4087-bd51-a76e3424a52f",
              "leftValue": "={{ $json.operation === 'cancel' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8a47337a-e2fd-5fdc-aa33-9b82e657687f",
      "name": "Cancel event",
