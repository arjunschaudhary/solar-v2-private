        "method": "POST",
        "url": "={{ $('Connection settings').first().json.api_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({token:$('Connection settings').first().json.api_token,type:\"queue_followups\",request_id:'n8n:'+$execution.id+':queue_followups'+':'+$itemIndex,payload:{},actor:'n8n'}) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
