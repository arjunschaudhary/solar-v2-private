      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "if(!$json.ok)return [{json:{ok:false,error_message:$json.error||'Document generation failed'}}];const r=$json.result;if(!r?.provider_id||!r.pdf_url||!r.document_url)throw new Error('Document response incomplete. Inspect Drive before retrying.');return [{json:{...r,ok:true}}];"
      },
